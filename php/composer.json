{
  "name": "misarai/misarseo-php",
  "description": "PHP client for the MisarSEO API: keyword research, site audits, rank tracking, backlinks, AI search visibility, Search Console, GA4 and Business Profile — 221 methods, retries, typed plan-limit errors with the upgrade offer, SSE crawl progress.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://seo.misar.io",
  "keywords": [
    "misarseo",
    "seo",
    "keyword-research",
    "rank-tracking",
    "site-audit",
    "backlinks",
    "search-console",
    "ai-search",
    "api-client",
    "sdk",
    "misar"
  ],
  "authors": [
    {
      "name": "Misar.AI",
      "email": "noreply@misar.io",
      "homepage": "https://misar.io",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/Misar-AI/misarseo-sdks/issues",
    "source": "https://github.com/Misar-AI/misarseo-sdks/tree/main/php",
    "docs": "https://docs.misar.io/seo"
  },
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "MisarSEO\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MisarSEO\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  }
}
