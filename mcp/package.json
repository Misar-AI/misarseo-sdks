  },
  "keywords": [
    "mcp",
    "seo",
    "keyword-research",
    "rank-tracking",
    "site-audit",
    "ai-brand-radar",
    "google-search-console",
    "model-context-protocol",
    "misarseo"
  ],
  "license": "MIT",
  "homepage": "https://seo.misar.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/misar-ai/seo-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/misar-ai/seo-mcp/issues"
  }
