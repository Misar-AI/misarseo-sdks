{
  "name": "@misar/seo-mcp",
  "version": "0.2.0",
  "description": "MisarSEO MCP server — keyword research, site audits, rank tracking, AI brand radar, and Google Search Console via the Model Context Protocol.",
  "type": "module",
  "bin": {
    "misarseo-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "publishConfig": {
